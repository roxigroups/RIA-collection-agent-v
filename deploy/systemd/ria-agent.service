[Unit]
Description=RIA Collection Agent - LiveKit Voice Agent Worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ria-collection-agent/backend
EnvironmentFile=/opt/ria-collection-agent/backend/.env
ExecStart=/opt/ria-collection-agent/backend/.venv/bin/python agent.py start
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
