[Unit]
Description=RIA Collection Agent - Standalone Outbound Dialer Daemon
After=network.target ria-api.service
Wants=ria-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ria-coolection-agent/backend
EnvironmentFile=/opt/ria-coolection-agent/backend/.env
ExecStart=/opt/ria-coolection-agent/backend/.venv/bin/python dialer.py
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
