LIVEKIT_URL="wss://your-livekit-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key_here"
LIVEKIT_API_SECRET="your_livekit_api_secret_here"
OPENAI_API_KEY="your_openai_api_key_here"
SMALLEST_API_KEY="your_smallest_ai_api_key_here"

# PostgreSQL: the dashboard, dialer and agent all use it. Create the tables and
# your company's first login with `python setup_db.py --company ... --admin-email ...`
DATABASE_URL="postgresql://ria:password@localhost:5432/ria_db"

# API server (server.py). The dashboard (frontend/, Next.js on port 3000) forwards
# /api here; users sign in with their own email and password from the users table.
PORT=5001
API_HOST="127.0.0.1"  # only the dashboard on this machine needs to reach it
FLASK_SECRET_KEY=""  # long random string; signs the sign-in cookie
SESSION_COOKIE_SECURE="0"  # 1 once the dashboard is served over HTTPS
DIALER_START_PAUSED="0"  # 1 = the dialer places no calls at all (a safety stop); imported batches always wait for "Start calling"

# Vobiz telephony (Vobiz console > SIP Trunk > Outbound Trunks > Trunks)
VOBIZ_SIP_DOMAIN="your_unique_domain.sip.vobiz.ai"
VOBIZ_USERNAME="your_vobiz_trunk_username"
VOBIZ_PASSWORD="your_vobiz_trunk_password"
VOBIZ_PHONE_NUMBER="+91XXXXXXXXXX"  # your Vobiz number, E.164
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=""  # printed by `python setup_vobiz.py`

# Invoice calls
COLLECTION_LANGUAGE="te"  # opening line (te, hi or en) when the call sheet has none; RIA then follows the customer
COLLECTION_CALL_HOURS="8-19"  # IST outer limit; each company's own hours (Settings) apply inside it
DIALER_CONCURRENCY="1"  # calls at the same time (1 = one after another)
MAX_CALL_MINUTES="3"  # hang up longer calls (cost guard)

# How a call works: Smallest Pulse transcribes the customer (Telugu, Hindi or
# English, following the conversation), the model writes RIA's replies from the
# transcript, and the cloned voice speaks them.
RIA_LLM_MODEL="gpt-4.1-mini"
STT_USD_PER_MIN="0.004"  # Pulse rate on your Smallest plan, for the per-call cost line
SMALLEST_TTS_VOICE_ID="voice_xxxxxxxx"  # your cloned voice (Smallest > Voices); Lightning v3.1 Pro
SMALLEST_TTS_SPEED="1.0"
SMALLEST_TTS_SAMPLE_RATE="16000"  # twice the phone line's rate; higher only slows the first audio
SMALLEST_NUMBER_LANGUAGE="en"  # how numbers, ₹ amounts and dates are read (te, hi, en)

# Turn-taking. Raise ENDPOINTING_MIN_DELAY if customers get cut off mid-sentence.
VAD_MIN_SILENCE_DURATION="0.5"
VAD_MIN_SPEECH_DURATION="0.15"
VAD_ACTIVATION_THRESHOLD="0.6"
ENDPOINTING_MIN_DELAY="0.1"
ENDPOINTING_MAX_DELAY="2.5"
FALSE_INTERRUPTION_TIMEOUT="1.5"  # a noise that interrupted RIA: resume her sentence after this

# Per-call cost line in the agent log (₹). Set your Vobiz plan's per-minute rate.
VOBIZ_INR_PER_MIN="0.5"
USD_INR="88"
