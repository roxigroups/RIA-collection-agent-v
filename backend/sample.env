LIVEKIT_URL="wss://your-livekit-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key_here"
LIVEKIT_API_SECRET="your_livekit_api_secret_here"
OPENAI_API_KEY="your_openai_api_key_here"
SMALLEST_API_KEY="your_smallest_ai_api_key_here"

# PostgreSQL: the dashboard, dialer and agent all use it. Create the tables and
# your company's first login with `python setup_db.py --company ... --admin-email ...`
DATABASE_URL="postgresql://ria:password@localhost:5432/ria_db"

# API server (server.py). The dashboard (frontend/, Next.js on port 3000) forwards
# /api here; users sign in with their own email and password from the users table.
PORT=5001
# Bind to 0.0.0.0 so reverse proxies / Cloudflare can connect
API_HOST="0.0.0.0"
# Long random string; signs the sign-in cookie
FLASK_SECRET_KEY=""
# Set to 1 once the dashboard is served over HTTPS
SESSION_COOKIE_SECURE="0"
# 1 = the dialer places no calls at all (safety stop); imported batches wait for Start calling
DIALER_START_PAUSED="0"

# Vobiz telephony (Vobiz console > SIP Trunk > Outbound Trunks > Trunks)
VOBIZ_SIP_DOMAIN="your_unique_domain.sip.vobiz.ai"
VOBIZ_USERNAME="your_vobiz_trunk_username"
VOBIZ_PASSWORD="your_vobiz_trunk_password"
# Your Vobiz number, E.164
VOBIZ_PHONE_NUMBER="+91XXXXXXXXXX"
# Printed by python setup_vobiz.py
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=""

# Opening line (te, hi or en) when the call sheet has none; RIA then follows the customer
COLLECTION_LANGUAGE="te"
# IST outer limit; each company's own hours apply inside it
COLLECTION_CALL_HOURS="8-19"
# Simultaneous calls (1 = sequential)
DIALER_CONCURRENCY="1"
# Hang up longer calls (cost guard)
MAX_CALL_MINUTES="3"

# How a call works: Smallest Pulse transcribes the customer, the model writes replies, and cloned voice speaks
RIA_LLM_MODEL="gpt-4.1-mini"
# Pulse rate on your Smallest plan, for per-call cost tracking
STT_USD_PER_MIN="0.004"
# Your cloned voice ID (Smallest > Voices); Lightning v3.1 Pro
SMALLEST_TTS_VOICE_ID="voice_mLYWPFWFVA"
SMALLEST_TTS_SPEED="1.0"
# Twice the phone line rate; higher only slows audio
SMALLEST_TTS_SAMPLE_RATE="16000"
# How numbers, ₹ amounts and dates are read (te, hi, en)
SMALLEST_NUMBER_LANGUAGE="en"

# Turn-taking: raise ENDPOINTING_MIN_DELAY if customers get cut off
VAD_MIN_SILENCE_DURATION="0.5"
VAD_MIN_SPEECH_DURATION="0.15"
VAD_ACTIVATION_THRESHOLD="0.6"
ENDPOINTING_MIN_DELAY="0.1"
ENDPOINTING_MAX_DELAY="2.5"
# Noise cancellation: "off" (recommended for self-hosted LiveKit to avoid 404 stalls); "bvc" for LiveKit Cloud
NOISE_CANCELLATION="off"
# Noise interruption recovery timeout in seconds
FALSE_INTERRUPTION_TIMEOUT="1.5"
# Silence timeout: seconds of complete silence before Ria asks "are you there?"
USER_AWAY_TIMEOUT="7.0"

# Per-call cost line in the agent log (₹). Set your Vobiz plan's per-minute rate.
VOBIZ_INR_PER_MIN="0.5"
USD_INR="88"

# Email for sign-up and password-reset codes (Google Workspace, app password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="gyan.ria@roxygroup.in"
SMTP_PASSWORD="cdjoodgreebvpspd"
SMTP_FROM="gyan.ria@roxygroup.in"
SMTP_FROM_NAME="RIA AI AGENT"
